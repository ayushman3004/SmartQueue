# ═══════════════════════════════════════════════════
# ServeQ / SmartQueue — Environment Variables
# ═══════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────
PORT=3001
NODE_ENV=development
# NODE_ENV=production  (set this on Render)

# ─── Database ─────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/smart-queue
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/smart-queue  (production)

# ─── Auth / JWT ───────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_to_random_string

# ─── Google OAuth ─────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Server URL (for Google OAuth callback) ───────
# On Render, this is auto-set as RENDER_EXTERNAL_URL
# Only set manually if you have a custom domain for the API
# SERVER_URL=https://smartqueue-p629.onrender.com

# ─── Client URL (frontend) ────────────────────────
# Development:
CLIENT_URL=http://localhost:5173
# Production (set on Render):
# CLIENT_URL=https://serveq.tech

# ─── Vite Frontend API URL ────────────────────────
# Development: leave empty to use Vite proxy
VITE_API_URL=
# Production (set on Vercel):
# VITE_API_URL=https://smartqueue-p629.onrender.com

# ─── AI ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Twilio (optional, for SMS OTP) ──────────────
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ─── Email Configuration (Resend or SMTP) ─────────
# OPTION A: Resend (Recommended)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# If you have verified your domain on Resend, specify your custom sender:
# EMAIL_FROM="serveQ Security <no-reply@yourdomain.com>"

# OPTION B: Gmail / Custom SMTP
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ─── Razorpay Payment Gateway ──────────────────────────
# Get your API keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
