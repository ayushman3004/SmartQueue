# ═══════════════════════════════════════════════════
# ServeQ / SmartQueue — Environment Variables
# ═══════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────
PORT=3001
NODE_ENV=development
# Render only. Set after the API hostname's Cloudflare request header rule is live.
# Requires the edge credential on application and Socket.IO requests.
# CLOUDFLARE_ORIGIN_SECRET=<64 lowercase hexadecimal characters>
# Required for a production backend. Use a private Redis/Valkey endpoint, or rediss:// for TLS.
# REDIS_URL=redis://127.0.0.1:6379
# RATE_LIMIT_KEY_SECRET=<64 lowercase hexadecimal characters shared by all backend instances>
# Turnstile server settings on Render. Deploy Vercel with the widget before enforcing.
# TURNSTILE_MODE=observe
# TURNSTILE_SECRET_KEY=
# TURNSTILE_ALLOWED_HOSTNAMES=serveq.tech,www.serveq.tech
# NODE_ENV=production  (set this on Render)

# ─── Database ─────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/smart-queue
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/smart-queue  (production)

# ─── Auth / JWT ───────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_to_random_string

# ─── Google OAuth ─────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Server URL (for Google OAuth callback) ───────
# On Render, this is auto-set as RENDER_EXTERNAL_URL
# Only set manually if you have a custom domain for the API
# SERVER_URL=https://api.serveq.tech

# ─── Client URL (frontend) ────────────────────────
# Development:
CLIENT_URL=http://localhost:5173
# Session cookie SameSite policy: lax (default), strict, or none.
# Use none only for cross-site HTTPS frontend/API deployments; Secure is mandatory.
AUTH_COOKIE_SAME_SITE=lax
# Production (set on Render):
# CLIENT_URL=https://serveq.tech

# ─── Vite Frontend API URL ────────────────────────
# Development: leave empty to use Vite proxy
VITE_API_URL=
# Public widget site key (set on Vercel). Use a separate widget for staging.
# VITE_TURNSTILE_SITE_KEY=
# Production (set on Vercel):
# VITE_API_URL=https://api.serveq.tech

# ─── AI (OpenAI SDK via OpenRouter) ───────────────
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: comma-separated list of OpenRouter API keys for automatic multi-key fallback & load balancing
# OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3
# Optional: override default model (e.g. nvidia/nemotron-3-ultra-550b-a55b:free, deepseek/deepseek-chat, openai/gpt-4o-mini)
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ─── Meta WhatsApp Cloud API (optional follow-up reminders) ────────
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_FOLLOW_UP_TEMPLATE=serveq_follow_up
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_GRAPH_API_VERSION=v27.0

# ─── Email Configuration (Resend or SMTP) ─────────
# OPTION A: Resend (Recommended)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# If you have verified your domain on Resend, specify your custom sender:
# EMAIL_FROM="serveQ Security <no-reply@yourdomain.com>"

# OPTION B: Gmail / Custom SMTP
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ─── Razorpay Payment Gateway ──────────────────────────
# Get your API keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# Backend only. Match the custom secret entered for /api/payments/webhook in Razorpay.
# This is separate from RAZORPAY_KEY_SECRET. Never use a VITE_ prefix for secrets.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ─── Google Maps Platform (Server-Side Proxy) ───────────
# Enable Places API and Geocoding API in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/overview
# Server-side key:
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Optional search radius in kilometers (default: 30)
DISCOVERY_SEARCH_RADIUS_KM=30


# Firebase SMS proof verification (backend only; never use a VITE_ prefix here).
# Match the project used by the frontend Firebase configuration.
# Use Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS), or set
# FIREBASE_SERVICE_ACCOUNT_JSON in the backend secret store (not in Git).
FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON={...service account JSON...}


# Public Firebase web configuration for Profile phone OTP.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
