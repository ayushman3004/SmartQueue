FROM node:26-alpine

WORKDIR /app

ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev

# Copy only application runtime files. Environment files and repository tooling
# must never become part of a production layer, even if ignore rules change.
COPY app.js server.js ./
COPY config ./config
COPY middleware ./middleware
COPY realtime ./realtime
COPY ai ./ai
COPY utils ./utils
COPY src ./src

EXPOSE 3001

CMD ["node", "server.js"]
