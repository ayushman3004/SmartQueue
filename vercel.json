{
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://api.serveq.tech/health"
    },
    {
      "source": "/health/(.*)",
      "destination": "https://api.serveq.tech/health/$1"
    },
    {
      "source": "/healthz",
      "destination": "https://api.serveq.tech/healthz"
    },
    {
      "source": "/live",
      "destination": "https://api.serveq.tech/live"
    },
    {
      "source": "/ready",
      "destination": "https://api.serveq.tech/ready"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://api.serveq.tech/api/$1"
    },
    {
      "source": "/login",
      "destination": "/app"
    },
    {
      "source": "/auth/callback",
      "destination": "/app"
    },
    {
      "source": "/customers",
      "destination": "/app"
    },
    {
      "source": "/history",
      "destination": "/app"
    },
    {
      "source": "/queue",
      "destination": "/app"
    },
    {
      "source": "/queue/:businessId",
      "destination": "/app"
    },
    {
      "source": "/booking",
      "destination": "/app"
    },
    {
      "source": "/booking/:businessId",
      "destination": "/app"
    },
    {
      "source": "/business/onboarding",
      "destination": "/app"
    },
    {
      "source": "/business/onboarding/:businessId",
      "destination": "/app"
    },
    {
      "source": "/business/:businessId",
      "destination": "/app"
    },
    {
      "source": "/business/:businessId/manage",
      "destination": "/app"
    },
    {
      "source": "/subscription",
      "destination": "/app"
    },
    {
      "source": "/profile",
      "destination": "/app"
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "www\\.serveq\\.tech" }],
      "destination": "/app"
    },
    {
      "source": "/401",
      "destination": "/app"
    },
    {
      "source": "/403",
      "destination": "/app"
    },
    {
      "source": "/unauthorized",
      "destination": "/app"
    },
    {
      "source": "/hub/:path*",
      "destination": "/app"
    },
    {
      "source": "/admin/:path*",
      "has": [{ "type": "host", "value": "www\\.serveq\\.tech" }],
      "destination": "/app"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/help",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/customer",
      "destination": "/customers",
      "permanent": true
    },
    {
      "source": "/coming-soon",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wallet",
      "destination": "/profile",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-QspVrLl5mJ4dc5SrDDIvgiqkZY0cUUzk5RDetZ+Da+E=' https://checkout.razorpay.com https://challenges.cloudflare.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data: blob:; frame-src 'self' https://*.razorpay.com https://challenges.cloudflare.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/ https://*.firebaseapp.com; connect-src 'self' https://api.serveq.tech wss://api.serveq.tech https://*.razorpay.com https://challenges.cloudflare.com https://www.google.com/recaptcha/ https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "buildCommand": "npm run ci:frontend",
  "installCommand": "npm ci --no-audit --no-fund"
}
