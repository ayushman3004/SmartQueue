{
  "name": "smart-queue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run server:dev\" \"npm run dev\"",
    "build": "node scripts/generate-sitemap.js && vite build && node scripts/generate-route-html.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "preview": "vite preview",
    "start": "node server.js",
    "server": "node server.js",
    "server:dev": "nodemon server.js",
    "check:build": "node scripts/check-production-build.mjs",
    "ci:frontend": "npm run lint && npm test && npm run build && npm run check:build"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.47.0",
    "mongoose": "^9.3.3",
    "nodemailer": "^10.1.1",
    "nodemailer-otp": "^1.0.8",
    "openai": "^7.53.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.21.0",
    "razorpay": "^2.9.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "redis": "^6.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1"
  },
  "overrides": {
    "nodemailer-otp": {
      "nodemailer": "$nodemailer"
    }
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
